local lista = script.Parent
local layout = lista:WaitForChild("UIListLayout")

lista.ScrollingEnabled = true
lista.ScrollingDirection = Enum.ScrollingDirection.Y
lista.ElasticBehavior = Enum.ElasticBehavior.Never

local function atualizar()
	lista.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 12)
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(atualizar)
atualizar()
]]></ProtectedString></Properties></Item></Item></Item><Item class="Frame" referent="RBX144"><Properties><string name="Name">Properties</string><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0.58</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.42</YS><YO>0</YO></UDim2><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><int name="BorderSizePixel">0</int><Color3 name="BackgroundColor3"><R>0.1020</R><G>0.0863</G><B>0.2000</B></Color3><float name="BackgroundTransparency">0</float></Properties><Item class="TextLabel" referent="RBX143"><Properties><string name="Name">Titulo</string><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0</YS><YO>36</YO></UDim2><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><int name="BorderSizePixel">0</int><Color3 name="BackgroundColor3"><R>0.1412</R><G>0.1176</G><B>0.2706</B></Color3><float name="BackgroundTransparency">0</float><string name="Text">Properties</string><Color3 name="TextColor3"><R>0.9255</R><G>0.9137</G><B>1.0000</B></Color3><int name="TextSize">13</int><token name="Font">19</token><token name="TextXAlignment">0</token><token name="TextTruncate">1</token></Properties><Item class="UIPadding" referent="RBX142"><Properties><string name="Name">UIPadding</string><UDim name="PaddingLeft"><S>0</S><O>14</O></UDim></Properties></Item></Item><Item class="ScrollingFrame" referent="RBX132"><Properties><string name="Name">ListaProperties</string><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0</YS><YO>36</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>-36</YO></UDim2><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><int name="BorderSizePixel">0</int><float name="BackgroundTransparency">1</float><UDim2 name="CanvasSize"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><token name="AutomaticCanvasSize">2</token><token name="ScrollingDirection">2</token><int name="ScrollBarThickness">6</int></Properties><Item class="UIPadding" ref