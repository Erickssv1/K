>0</Y></Vector2><int name="BorderSizePixel">0</int><Color3 name="BackgroundColor3"><R>0.0706</R><G>0.0588</G><B>0.1412</B></Color3><float name="BackgroundTransparency">0.4</float><string name="Text">Viewport 3D</string><Color3 name="TextColor3"><R>0.6039</R><G>0.5765</G><B>0.7882</B></Color3><int name="TextSize">12</int><token name="Font">17</token><token name="TextXAlignment">2</token><token name="TextTruncate">1</token></Properties></Item></Item><Item class="Frame" referent="RBX145"><Properties><string name="Name">PainelLateral</string><UDim2 name="Position"><XS>1</XS><XO>0</XO><YS>0</YS><YO>56</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>230</XO><YS>1</YS><YO>-56</YO></UDim2><Vector2 name="AnchorPoint"><X>1</X><Y>0</Y></Vector2><int name="BorderSizePixel">0</int><Color3 name="BackgroundColor3"><R>0.1020</R><G>0.0863</G><B>0.2000</B></Color3><float name="BackgroundTransparency">0</float></Properties><Item class="TextButton" referent="RBX136"><Properties><string name="Name">AlcaRedimensionar</string><UDim2 name="Position"><XS>0</XS><XO>-15</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>30</XO><YS>1</YS><YO>0</YO></UDim2><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><int name="BorderSizePixel">0</int><float name="BackgroundTransparency">1</float><string name="Text"></string><bool name="AutoButtonColor">false</bool><int name="ZIndex">5</int></Properties><Item class="Frame" referent="RBX134"><Properties><string name="Name">Pino</string><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0</XS><XO>6</XO><YS>0</YS><YO>48</YO></UDim2><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><int name="BorderSizePixel">0</int><Color3 name="BackgroundColor3"><R>0.5608</R><G>0.5255</G><B>1.0000</B></Color3><float name="BackgroundTransparency">0</float></Properties><Item class="UICorner" referent="RBX133"><Properties><string name="Name">UICorner</string><UDim name="CornerRadius"><S>0</S><O>3</O></UDim></Properties></Item></Item><Item class="LocalScript" referent="RBX135"><Properties><string name="Name">ExplorerResize</string><ProtectedString name="Source"><![CDATA[-- Redimensionamento horizontal do Explorer (painel lateral)
local UserInputService = game:GetService("UserInputService")

local alca = script.Parent
local painel = alca.Parent
local MIN_LARGURA = 150
local MAX_PROPORCAO = 0.7

local arrastando = false
local xInicial, larguraInicial = 0, 0

local function ehToque(input)
	return input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
end

alca.InputBegan:Connect(function(input)
	if ehToque(input) then
		arrastando = true
		xInicial = input.Position.X
		larguraInicial = painel.AbsoluteSize.X
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if arrastando and (input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local maxLargura = painel.Parent.AbsoluteSize.X * MAX_PROPORCAO
		local largura = math.clamp(larguraInicial - (input.Position.X - xInicial), MIN_LARGURA, maxLargura)
		painel.Size = UDim2.new(0, largura, painel.Size.Y.Scale, painel.Size.Y.Offset)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if ehToque(input) then arrastando = false end
end)
